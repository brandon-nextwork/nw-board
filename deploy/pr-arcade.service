[Unit]
Description=PR Arcade server (webhook receiver + display server)
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
# The Pi has no RTC: it boots on the last saved time until NTP corrects it, and
# Quiet Hours, Day Chimes, the MVP and the Arcade Theme's midnight all read the
# clock. time-sync.target only waits for a real sync when a wait service is
# enabled; install.sh enables one, capped so an offline boot still starts us.

[Service]
Type=simple
EnvironmentFile=/etc/pr-arcade.env
Restart=always
RestartSec=5

# User, WorkingDirectory and ExecStart are deliberately NOT set here: they
# depend on where the repo was cloned, who runs it, and where npm ended up.
# install.sh writes them to
# /etc/systemd/system/pr-arcade.service.d/10-local.conf, which is the single
# source of truth. Without that drop-in this unit refuses to start — by design,
# so a missing install fails loudly rather than running the wrong thing.

[Install]
WantedBy=multi-user.target
